<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/dreamu_qcm/db" VERSION="2026050601" COMMENT="Dream-U QCM Generator tables">
  <TABLES>
    <TABLE NAME="local_dreamu_qcm" COMMENT="Generated questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="qtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="multichoice" COMMENT="multichoice, truefalse, shortanswer, matching, numerical"/>
        <FIELD NAME="question" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="optiona" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="optionb" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="optionc" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="optiond" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="correct" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="a"/>
        <FIELD NAME="difficulty" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="medium"/>
        <FIELD NAME="explanation" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="extra_data" TYPE="text" NOTNULL="false" COMMENT="JSON for matching pairs, numerical tolerance, etc."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
